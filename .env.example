# Copia este archivo como .env y pon tus valores. El .env no se sube al repo.

# Base de datos SQLite (SQLAlchemy). Por defecto: data/usuarios.sqlite
DATABASE_PATH=data/usuarios.sqlite

# Clave de la API de Gemini: https://aistudio.google.com/apikey
# Sin ella la app funciona igual, pero sin IA: no aparecen el asistente de Movimientos ni el análisis del Resumen.
GEMINI_API_KEY=

# Opcional: modelo a usar. Por defecto, gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-flash-lite-latest

# Clave para firmar la cookie de sesión. En producción (ENVIRONMENT=production) es obligatoria y de al
# menos 32 caracteres: sin ella la app no arranca. En desarrollo, si falta, se usa una al azar y las
# sesiones se cierran cada vez que se reinicia el servidor. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Google OAuth: pantallas de consentimiento y credenciales OAuth (tipo "Aplicación web", con el URI
# de redirección http://localhost:8000/auth/google/callback). En modo "Prueba" solo entran los correos
# que agregues como usuarios de prueba.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# FASTAPI_ENV no va aquí. "fastapi dev" la pone en "development" y así los cambios en las plantillas
# se ven al recargar la página; fuera de desarrollo no se revisan en cada petición, que es más rápido.
# Si arrancas con "uvicorn --reload", expórtala en la terminal (FASTAPI_ENV=development uvicorn ...):
# en este archivo no sirve, porque app/main.py lee el .env después de cargar las plantillas.
