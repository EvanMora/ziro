# Copia este archivo como .env y pon tus valores. El .env no se sube al repo.

# Clave de la API de Gemini: https://aistudio.google.com/apikey
# Sin ella la app funciona igual, pero sin IA: no aparecen el asistente de Movimientos ni el análisis del Resumen.
GEMINI_API_KEY=

# Opcional: modelo a usar. Por defecto, gemini-flash-lite-latest.
# GEMINI_MODEL=gemini-flash-lite-latest

# Clave para firmar la cookie de sesión (la SessionMiddleware de Starlette la necesita). Cadena larga
# y aleatoria en producción; en desarrollo el valor por defecto sirve.
SECRET_KEY=

# Google OAuth: pantallas de consentimiento y credenciales OAuth (tipo "Aplicación web", con el URI
# de redirección http://localhost:8000/auth/google/callback). En modo "Prueba" solo entran los correos
# que agregues como usuarios de prueba.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
